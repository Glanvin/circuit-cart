CI_ENV="development"
SITE_NAME="Circuit Cart"

# Shown in the footer badge. index.php carries the same value as its default,
# so leaving this out is fine; set it only to pin a deployed instance.
APP_VERSION="0.4.2"

# Base URL of this app. If empty/unset, config.php auto-detects from HTTP_HOST.
BASE_URL="http://localhost/ci3/"

# MySQL (XAMPP defaults)
DATABASE_NAME="circuit_cart"
DATABASE_HOSTNAME="localhost"
DATABASE_PORT="3306"
DATABASE_USERNAME="root"
DATABASE_PASSWORD=""

# SMTP Gmail SMTP_PASS must be a Gmail app password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_CRYPTO="ssl"
SMTP_USER=""
SMTP_PASS=""